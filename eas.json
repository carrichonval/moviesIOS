{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "__APPLE_ID__",
        "ascAppId": "__ASC_APP_ID__",
        "appleTeamId": "__APPLE_TEAM_ID__"
      }
    }
  }
}
